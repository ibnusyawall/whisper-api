# Server Configuration
PORT=3000
NODE_ENV=production

# Sandbox Configuration
# Set to false in production to disable automatic cleanup
SANDBOX_MODE=true

# Logging Configuration
LOG_LEVEL=info
DEBUG=true


# WhatsApp Configuration
# Available modes: 'single', 'multi', 'both'
# - single: Only legacy single-instance mode
# - multi: Only multi-instance mode (default)
# - both: Both modes running simultaneously
WHATSAPP_MODE=multi

# Optional HTTP CONNECT proxy for Baileys (URL-encode special characters in credentials)
# WHATSAPP_PROXY_URL=http://USERNAME:PASSWORD@HOST:PORT
# Set true on a VPS to prevent direct WhatsApp sockets if the URL is missing
WHATSAPP_PROXY_REQUIRED=false

# Database
DATABASE_URL="mongodb://localhost:27017/whisper-api?replicaSet=rs0"
